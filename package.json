{
  "name": "license-manager",
  "version": "1.1.0",
  "description": "Sistema completo de administración de licencias con dashboard, API REST, pagos y verificación de dispositivos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeders/adminSeeder.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "license",
    "manager",
    "dashboard",
    "api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "coinbase-commerce-node": "^1.0.4",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-handlebars": "^7.1.2",
    "express-rate-limit": "^7.1.4",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailgun-js": "^0.22.0",
    "method-override": "^3.0.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1",
    "paypal-rest-sdk": "^1.8.1",
    "sequelize": "^6.35.0",
    "sqlite3": "^5.1.6",
    "stripe": "^14.8.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
