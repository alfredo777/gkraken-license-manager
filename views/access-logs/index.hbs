<div class="space-y-6"><div><h1 class="text-2xl font-bold text-gray-900">Registros de Acceso</h1><p class="text-sm text-gray-500 mt-1">{{pagination.total}} registros</p></div><div class="bg-white rounded-xl border overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">Acción</th><th class="px-4 py-3">IP</th><th class="px-4 py-3">País</th><th class="px-4 py-3">Resultado</th><th class="px-4 py-3">App</th><th class="px-4 py-3">Fecha</th></tr></thead><tbody class="divide-y">{{#each logs}}<tr class="hover:bg-gray-50"><td class="px-4 py-2.5 text-xs font-medium">{{this.license.name}}</td><td class="px-4 py-2.5"><span class="px-2 py-0.5 text-xs rounded-full bg-gray-100">{{this.action}}</span></td><td class="px-4 py-2.5 font-mono text-xs">{{this.ip_address}}</td><td class="px-4 py-2.5 text-xs">{{this.country}}/{{this.city}}</td><td class="px-4 py-2.5">{{#if this.response_status}}<span class="text-green-600 text-xs">✓</span>{{else}}<span class="text-red-500 text-xs">✗</span>{{/if}}</td><td class="px-4 py-2.5 text-xs">{{this.app_version}}</td><td class="px-4 py-2.5 text-xs text-gray-500">{{formatDateTime this.accessed_at}}</td></tr>{{/each}}</tbody></table></div>{{#if (gt pagination.totalPages 1)}}<div class="px-4 py-3 bg-gray-50 border-t flex justify-between"><span class="text-sm text-gray-500">Pág {{pagination.page}}/{{pagination.totalPages}}</span><div class="flex gap-1">{{#if pagination.hasPrev}}<a href="?page={{inc (inc pagination.page -2)}}" class="px-3 py-1 text-sm border rounded-lg">Ant</a>{{/if}}{{#if pagination.hasNext}}<a href="?page={{inc pagination.page}}" class="px-3 py-1 text-sm border rounded-lg">Sig</a>{{/if}}</div></div>{{/if}}</div></div>
