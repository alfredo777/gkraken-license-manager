<div class="space-y-6"><div><h1 class="text-2xl font-bold text-white">Registros de Acceso</h1><p class="text-sm text-gray-500 mt-1">{{pagination.total}} registros</p></div><div class="glass-card overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left text-[10px] text-gray-500 uppercase tracking-wider" style="background:rgba(255,255,255,0.02)"><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">Accion</th><th class="px-4 py-3">IP</th><th class="px-4 py-3">Pais</th><th class="px-4 py-3">Resultado</th><th class="px-4 py-3">App</th><th class="px-4 py-3">Fecha</th></tr></thead><tbody class="divide-y divide-white/[0.04]">{{#each logs}}<tr class="hover:bg-emerald-500/[0.03] transition-colors"><td class="px-4 py-2.5 text-xs font-medium text-gray-300">{{this.license.name}}</td><td class="px-4 py-2.5"><span class="px-2 py-0.5 text-[10px] rounded-full text-gray-400" style="background:rgba(255,255,255,0.05)">{{this.action}}</span></td><td class="px-4 py-2.5 font-mono text-xs text-gray-500">{{this.ip_address}}</td><td class="px-4 py-2.5 text-xs text-gray-400">{{this.country}}/{{this.city}}</td><td class="px-4 py-2.5">{{#if this.response_status}}<span class="text-emerald-400 text-xs">&#10003;</span>{{else}}<span class="text-red-400 text-xs">&#10007;</span>{{/if}}</td><td class="px-4 py-2.5 text-xs text-gray-500">{{this.app_version}}</td><td class="px-4 py-2.5 text-xs text-gray-500">{{formatDateTime this.accessed_at}}</td></tr>{{/each}}</tbody></table></div>{{#if (gt pagination.totalPages 1)}}<div class="px-4 py-3 border-t border-white/[0.04] flex justify-between" style="background:rgba(255,255,255,0.02)"><span class="text-sm text-gray-500">Pag {{pagination.page}}/{{pagination.totalPages}}</span><div class="flex gap-1">{{#if pagination.hasPrev}}<a href="?page={{inc (inc pagination.page -2)}}" class="px-3 py-1 text-sm border border-white/[0.08] rounded-lg text-gray-400 hover:bg-white/[0.04]">Ant</a>{{/if}}{{#if pagination.hasNext}}<a href="?page={{inc pagination.page}}" class="px-3 py-1 text-sm border border-white/[0.08] rounded-lg text-gray-400 hover:bg-white/[0.04]">Sig</a>{{/if}}</div></div>{{/if}}</div></div>
