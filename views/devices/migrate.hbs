<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center gap-3"><a href="/dashboard/licenses/{{license.id}}" class="p-2 text-gray-500 hover:bg-white/[0.06] rounded-lg transition-colors"><i class="ri-arrow-left-line text-lg"></i></a><h1 class="text-2xl font-bold text-white">Migrar Dispositivo</h1></div>
  <div class="glass-card p-6"><h2 class="font-semibold text-white">Licencia: <code class="text-sm text-gray-400">{{license.license_key}}</code></h2><p class="text-sm text-gray-500">{{license.name}} ({{license.email}})</p></div>
  <form action="/dashboard/devices/migrate/{{license.id}}" method="POST" class="space-y-6">
    <div class="glass-card p-6"><h3 class="text-lg font-semibold text-white mb-4">Nuevo Dispositivo</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">ID *</label><input type="text" name="new_device_id" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Nombre</label><input type="text" name="new_device_name" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">SO</label><input type="text" name="new_device_os" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">CPU</label><input type="text" name="new_device_cpu" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">RAM</label><input type="text" name="new_device_ram" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div></div><div class="mt-4"><label class="block text-sm font-medium text-gray-400 mb-1">Razon</label><textarea name="reason" rows="2" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200 resize-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></textarea></div></div>
    <button type="submit" class="w-full py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700 transition-colors"><i class="ri-swap-line mr-2"></i> Migrar</button>
  </form>
</div>
