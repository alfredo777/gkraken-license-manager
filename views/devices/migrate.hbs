<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center gap-3"><a href="/dashboard/licenses/{{license.id}}" class="p-2 text-gray-500 hover:bg-gray-100 rounded-lg"><i class="ri-arrow-left-line text-lg"></i></a><h1 class="text-2xl font-bold text-gray-900">Migrar Dispositivo</h1></div>
  <div class="bg-white rounded-xl border p-6"><h2 class="font-semibold">Licencia: <code class="text-sm">{{license.license_key}}</code></h2><p class="text-sm text-gray-600">{{license.name}} ({{license.email}})</p></div>
  <form action="/dashboard/devices/migrate/{{license.id}}" method="POST" class="space-y-6">
    <div class="bg-white rounded-xl border p-6"><h3 class="text-lg font-semibold mb-4">Nuevo Dispositivo</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium mb-1">ID *</label><input type="text" name="new_device_id" required class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Nombre</label><input type="text" name="new_device_name" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">SO</label><input type="text" name="new_device_os" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">CPU</label><input type="text" name="new_device_cpu" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">RAM</label><input type="text" name="new_device_ram" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div></div><div class="mt-4"><label class="block text-sm font-medium mb-1">Razón</label><textarea name="reason" rows="2" class="w-full px-4 py-2.5 border rounded-xl text-sm resize-none"></textarea></div></div>
    <button type="submit" class="w-full py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700"><i class="ri-swap-line mr-2"></i> Migrar</button>
  </form>
</div>
