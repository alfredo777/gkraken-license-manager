<div class="space-y-6"><h1 class="text-2xl font-bold text-white">Dispositivos</h1><div class="glass-card overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left text-[10px] text-gray-500 uppercase tracking-wider" style="background:rgba(255,255,255,0.02)"><th class="px-4 py-3">Dispositivo</th><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">SO</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Ultimo acceso</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody class="divide-y divide-white/[0.04]">{{#each devices}}<tr class="hover:bg-emerald-500/[0.03] transition-colors"><td class="px-4 py-3"><p class="font-medium text-gray-200">{{this.device_name}}</p><p class="font-mono text-xs text-gray-500">{{truncate this.device_id 25}}</p></td><td class="px-4 py-3"><p class="text-sm text-gray-300">{{this.license.name}}</p></td><td class="px-4 py-3 text-sm text-gray-400">{{this.device_os}}</td><td class="px-4 py-3">{{#if this.is_active}}<span class="px-2 py-1 text-xs rounded-full text-emerald-400" style="background:rgba(45,212,168,0.1)">Activo</span>{{else}}<span class="px-2 py-1 text-xs rounded-full text-gray-500" style="background:rgba(255,255,255,0.05)">Inactivo</span>{{/if}}</td><td class="px-4 py-3 text-xs text-gray-500">{{formatDateTime this.last_seen}}</td><td class="px-4 py-3"><div class="flex gap-1"><a href="/dashboard/devices/migrate/{{this.license_id}}" class="p-1.5 text-gray-500 hover:text-blue-400 hover:bg-blue-500/10 rounded-lg transition-colors"><i class="ri-swap-line"></i></a>{{#if this.is_active}}<form action="/dashboard/devices/{{this.id}}/deactivate" method="POST" class="inline"><button class="p-1.5 text-gray-500 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors"><i class="ri-shut-down-line"></i></button></form>{{/if}}</div></td></tr>{{/each}}</tbody></table></div></div></div>
