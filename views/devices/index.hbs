<div class="space-y-6"><h1 class="text-2xl font-bold text-gray-900">Dispositivos</h1><div class="bg-white rounded-xl border overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-4 py-3">Dispositivo</th><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">SO</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Último acceso</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody class="divide-y">{{#each devices}}<tr class="hover:bg-gray-50"><td class="px-4 py-3"><p class="font-medium">{{this.device_name}}</p><p class="font-mono text-xs text-gray-500">{{truncate this.device_id 25}}</p></td><td class="px-4 py-3"><p class="text-sm">{{this.license.name}}</p></td><td class="px-4 py-3 text-sm">{{this.device_os}}</td><td class="px-4 py-3">{{#if this.is_active}}<span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded-full">Activo</span>{{else}}<span class="px-2 py-1 text-xs bg-gray-100 text-gray-600 rounded-full">Inactivo</span>{{/if}}</td><td class="px-4 py-3 text-xs text-gray-500">{{formatDateTime this.last_seen}}</td><td class="px-4 py-3"><div class="flex gap-1"><a href="/dashboard/devices/migrate/{{this.license_id}}" class="p-1.5 hover:bg-blue-50 hover:text-blue-600 rounded-lg"><i class="ri-swap-line"></i></a>{{#if this.is_active}}<form action="/dashboard/devices/{{this.id}}/deactivate" method="POST" class="inline"><button class="p-1.5 hover:bg-red-50 hover:text-red-600 rounded-lg"><i class="ri-shut-down-line"></i></button></form>{{/if}}</div></td></tr>{{/each}}</tbody></table></div></div></div>
