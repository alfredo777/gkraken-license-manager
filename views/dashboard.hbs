<div class="space-y-6">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md"><div class="flex items-center justify-between"><div><p class="text-sm text-gray-500">Total Licencias</p><p class="text-2xl font-bold text-gray-900 mt-1">{{stats.totalLicenses}}</p></div><div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center"><i class="ri-key-2-fill text-blue-600 text-xl"></i></div></div><div class="mt-3 flex items-center gap-2 text-xs"><span class="text-green-600 font-semibold">{{stats.activeLicenses}} activas</span><span class="text-gray-300">|</span><span class="text-red-500">{{stats.expiredLicenses}} expiradas</span></div></div>
    <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md"><div class="flex items-center justify-between"><div><p class="text-sm text-gray-500">Licencias PRO</p><p class="text-2xl font-bold text-purple-700 mt-1">{{stats.proLicenses}}</p></div><div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center"><i class="ri-vip-crown-fill text-purple-600 text-xl"></i></div></div><div class="mt-3 text-xs text-gray-500">{{stats.freeLicenses}} free</div></div>
    <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md"><div class="flex items-center justify-between"><div><p class="text-sm text-gray-500">Ingresos Mes</p><p class="text-2xl font-bold text-green-700 mt-1">${{stats.monthlyRevenue}}</p></div><div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center"><i class="ri-money-dollar-circle-fill text-green-600 text-xl"></i></div></div><div class="mt-3 text-xs text-gray-500">Total: ${{stats.totalPayments}}</div></div>
    <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md"><div class="flex items-center justify-between"><div><p class="text-sm text-gray-500">Dispositivos</p><p class="text-2xl font-bold text-gray-900 mt-1">{{stats.totalDevices}}</p></div><div class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center"><i class="ri-computer-fill text-orange-600 text-xl"></i></div></div><div class="mt-3 text-xs"><span class="text-orange-600 font-semibold">{{stats.expiringSoon}} expiran pronto</span></div></div>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-1 bg-white rounded-xl border border-gray-200 p-6"><h3 class="text-lg font-semibold text-gray-900 mb-4">Acciones Rápidas</h3>
      <a href="/dashboard/licenses/create" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 mb-2"><div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center"><i class="ri-add-circle-line text-primary-600"></i></div><div><p class="text-sm font-medium">Nueva Licencia</p></div></a>
      <a href="/dashboard/licenses?status=expired" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50 mb-2"><div class="w-10 h-10 bg-red-50 rounded-lg flex items-center justify-center"><i class="ri-time-line text-red-600"></i></div><div><p class="text-sm font-medium">Licencias Expiradas</p></div></a>
      <a href="/dashboard/access-logs" class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-50"><div class="w-10 h-10 bg-amber-50 rounded-lg flex items-center justify-center"><i class="ri-file-list-3-line text-amber-600"></i></div><div><p class="text-sm font-medium">Logs ({{stats.totalVerifications}})</p></div></a>
    </div>
    <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 p-6"><h3 class="text-lg font-semibold text-gray-900 mb-4">Accesos Recientes</h3><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left text-xs text-gray-500 uppercase border-b"><th class="pb-3 pr-4">Licencia</th><th class="pb-3 pr-4">Acción</th><th class="pb-3 pr-4">IP</th><th class="pb-3">Fecha</th></tr></thead><tbody>{{#each stats.recentAccess}}<tr class="border-b border-gray-50 hover:bg-gray-50"><td class="py-2.5 pr-4 text-xs font-medium">{{this.license.name}}</td><td class="py-2.5 pr-4"><span class="px-2 py-0.5 text-xs rounded-full bg-gray-100">{{this.action}}</span></td><td class="py-2.5 pr-4 font-mono text-xs text-gray-500">{{this.ip_address}}</td><td class="py-2.5 text-xs text-gray-500">{{formatDateTime this.accessed_at}}</td></tr>{{/each}}</tbody></table></div></div>
  </div>
</div>
