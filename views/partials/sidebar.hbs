<aside class="hidden md:flex md:flex-col w-64 border-r border-white/[0.06] shadow-2xl" id="sidebar" style="background:rgba(10,10,18,0.95);backdrop-filter:blur(16px)">
  <div class="p-6 border-b border-white/[0.06]">
    <a href="/dashboard" class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-shield-keyhole-fill text-white text-xl"></i></div>
      <div><h1 class="text-lg font-bold text-white">{{appName}}</h1><p class="text-xs text-gray-500">License Manager</p></div>
    </a>
  </div>
  <nav class="flex-1 py-4 overflow-y-auto">
    <div class="px-4 mb-2"><p class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest">Principal</p></div>
    <a href="/dashboard" class="sidebar-link flex items-center gap-3 px-6 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/[0.04] transition-colors"><i class="ri-dashboard-3-line text-lg"></i> Dashboard</a>
    <a href="/dashboard/licenses" class="sidebar-link flex items-center gap-3 px-6 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/[0.04] transition-colors"><i class="ri-key-2-line text-lg"></i> Licencias</a>
    <a href="/dashboard/devices" class="sidebar-link flex items-center gap-3 px-6 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/[0.04] transition-colors"><i class="ri-computer-line text-lg"></i> Dispositivos</a>
    <div class="px-4 mt-6 mb-2"><p class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest">Financiero</p></div>
    <a href="/dashboard/payments" class="sidebar-link flex items-center gap-3 px-6 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/[0.04] transition-colors"><i class="ri-bank-card-line text-lg"></i> Pagos</a>
    <div class="px-4 mt-6 mb-2"><p class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest">Seguridad</p></div>
    <a href="/dashboard/access-logs" class="sidebar-link flex items-center gap-3 px-6 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/[0.04] transition-colors"><i class="ri-file-list-3-line text-lg"></i> Logs de Acceso</a>
    <div class="px-4 mt-6 mb-2"><p class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest">Sistema</p></div>
    <a href="/admin/profile" class="sidebar-link flex items-center gap-3 px-6 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/[0.04] transition-colors"><i class="ri-user-settings-line text-lg"></i> Mi Perfil</a>
    {{#ifCond admin.role '===' 'superadmin'}}<a href="/admin/settings" class="sidebar-link flex items-center gap-3 px-6 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/[0.04] transition-colors"><i class="ri-settings-3-line text-lg"></i> Configuracion</a>{{/ifCond}}
  </nav>
  <div class="p-4 border-t border-white/[0.06]">
    <div class="flex items-center gap-3 px-2">
      <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background:rgba(45,212,168,0.15)"><i class="ri-user-line" style="color:#2DD4A8"></i></div>
      <div class="flex-1 min-w-0"><p class="text-sm font-medium text-gray-200 truncate">{{admin.username}}</p><p class="text-xs text-gray-500 truncate">{{admin.role}}</p></div>
    </div>
  </div>
</aside>
