<div class="min-h-screen py-12 px-4" style="background:#0a0a0f"><div class="max-w-2xl mx-auto space-y-6">
  <div class="text-center"><div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background:linear-gradient(135deg,#6366F1,#4f46e5)"><i class="ri-vip-crown-fill text-white text-3xl"></i></div><h1 class="text-3xl font-bold text-white">Licencia PRO</h1></div>
  <div class="glass-card p-6"><h2 class="text-lg font-semibold text-white mb-4">Plan</h2><div class="grid grid-cols-2 gap-3"><label class="cursor-pointer"><input type="radio" name="selected_plan" value="monthly" class="hidden peer"><div class="p-4 border-2 border-white/[0.08] rounded-xl text-center peer-checked:border-emerald-500" style="background:rgba(255,255,255,0.02)"><p class="text-2xl font-bold text-white">${{priceMonthly}}</p><p class="text-sm text-gray-500">por mes</p></div></label><label class="cursor-pointer"><input type="radio" name="selected_plan" value="annual" class="hidden peer" checked><div class="p-4 border-2 border-white/[0.08] rounded-xl text-center peer-checked:border-emerald-500 relative" style="background:rgba(255,255,255,0.02)"><span class="absolute -top-2 left-1/2 -translate-x-1/2 px-2 py-0.5 text-white text-xs rounded-full" style="background:#2DD4A8">-42%</span><p class="text-2xl font-bold text-white">${{priceAnnual}}</p><p class="text-sm text-gray-500">por ano</p></div></label></div></div>
  <div class="glass-card p-6"><h2 class="text-lg font-semibold text-white mb-4">Pago</h2><div id="card-element" class="p-3 rounded-xl mb-2" style="border:1px solid rgba(255,255,255,0.08)"></div><div id="card-errors" class="text-red-400 text-sm mb-3"></div><button id="stripePayBtn" class="w-full py-3 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700 transition-colors mb-4"><i class="ri-bank-card-line mr-2"></i> Tarjeta</button><div class="border-t border-white/[0.06] my-4"></div><button id="paypalPayBtn" class="w-full py-3 bg-yellow-500 text-gray-900 rounded-xl font-semibold hover:bg-yellow-400 transition-colors mb-4"><i class="ri-paypal-line mr-2"></i> PayPal</button><div class="border-t border-white/[0.06] my-4"></div><button id="bitcoinPayBtn" class="w-full py-3 bg-orange-500 text-white rounded-xl font-semibold hover:bg-orange-600 transition-colors"><i class="ri-bit-coin-line mr-2"></i> Bitcoin</button></div>
</div></div>
<script>
const selectedPlan=()=>document.querySelector('input[name="selected_plan"]:checked')?.value||'annual';
const licenseId='{{license.id}}'||'';
{{#if stripeKey}}const stripe=Stripe('{{stripeKey}}');const elements=stripe.elements();const cardElement=elements.create('card');cardElement.mount('#card-element');
document.getElementById('stripePayBtn').addEventListener('click',async()=>{const btn=document.getElementById('stripePayBtn');btn.disabled=true;btn.textContent='Procesando...';try{const r=await fetch('/payments/stripe/create-intent',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({plan_type:selectedPlan(),license_id:licenseId})});const d=await r.json();if(d.clientSecret){const{error}=await stripe.confirmCardPayment(d.clientSecret,{payment_method:{card:cardElement}});if(error)document.getElementById('card-errors').textContent=error.message;else window.location.href='/payments/success';}}catch(e){document.getElementById('card-errors').textContent=e.message}btn.disabled=false;btn.innerHTML='<i class="ri-bank-card-line mr-2"></i> Tarjeta';});{{/if}}
document.getElementById('paypalPayBtn').addEventListener('click',async()=>{try{const r=await fetch('/payments/paypal/create-order',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({plan_type:selectedPlan(),license_id:licenseId})});const d=await r.json();if(d.approval_url)window.location.href=d.approval_url}catch(e){console.error(e)}});
document.getElementById('bitcoinPayBtn').addEventListener('click',async()=>{try{const r=await fetch('/payments/bitcoin/create-charge',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({plan_type:selectedPlan(),license_id:licenseId})});const d=await r.json();if(d.hosted_url)window.location.href=d.hosted_url}catch(e){console.error(e)}});
</script>
