<div class="space-y-6"><div class="flex items-center justify-between"><div><h1 class="text-2xl font-bold text-gray-900">Pagos</h1><p class="text-sm text-gray-500 mt-1">Total: <span class="font-semibold text-green-600">${{totalRevenue}}</span></p></div></div><div class="bg-white rounded-xl border overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">Monto</th><th class="px-4 py-3">Método</th><th class="px-4 py-3">Plan</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Fecha</th></tr></thead><tbody class="divide-y">{{#each payments}}<tr class="hover:bg-gray-50"><td class="px-4 py-3"><p class="font-medium">{{this.license.name}}</p></td><td class="px-4 py-3 font-semibold text-green-700">${{this.amount}}</td><td class="px-4 py-3 capitalize text-xs"><span class="px-2 py-1 rounded-full bg-gray-100">{{this.method}}</span></td><td class="px-4 py-3 capitalize text-sm">{{this.plan_type}}</td><td class="px-4 py-3">{{{statusBadge this.status}}}</td><td class="px-4 py-3 text-xs text-gray-500">{{formatDateTime this.paid_at}}</td></tr>{{/each}}</tbody></table></div></div></div>
