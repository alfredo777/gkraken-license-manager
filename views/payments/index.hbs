<div class="space-y-6"><div class="flex items-center justify-between"><div><h1 class="text-2xl font-bold text-white">Pagos</h1><p class="text-sm text-gray-500 mt-1">Total: <span class="font-semibold" style="color:#2DD4A8">${{totalRevenue}}</span></p></div></div><div class="glass-card overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left text-[10px] text-gray-500 uppercase tracking-wider" style="background:rgba(255,255,255,0.02)"><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">Monto</th><th class="px-4 py-3">Metodo</th><th class="px-4 py-3">Plan</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Fecha</th></tr></thead><tbody class="divide-y divide-white/[0.04]">{{#each payments}}<tr class="hover:bg-emerald-500/[0.03] transition-colors"><td class="px-4 py-3"><p class="font-medium text-gray-200">{{this.license.name}}</p></td><td class="px-4 py-3 font-semibold" style="color:#2DD4A8">${{this.amount}}</td><td class="px-4 py-3 capitalize text-xs"><span class="px-2 py-1 rounded-full text-gray-400" style="background:rgba(255,255,255,0.05)">{{this.method}}</span></td><td class="px-4 py-3 capitalize text-sm text-gray-300">{{this.plan_type}}</td><td class="px-4 py-3">{{{statusBadge this.status}}}</td><td class="px-4 py-3 text-xs text-gray-500">{{formatDateTime this.paid_at}}</td></tr>{{/each}}</tbody></table></div></div></div>
