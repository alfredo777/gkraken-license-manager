<div class="space-y-6">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4"><div class="flex items-center gap-3"><a href="/dashboard/licenses" class="p-2 text-gray-500 hover:bg-white/[0.06] rounded-lg transition-colors"><i class="ri-arrow-left-line text-lg"></i></a><div><h1 class="text-2xl font-bold text-white">{{license.name}}</h1><code class="text-sm px-2 py-1 rounded font-mono text-gray-400" style="background:rgba(255,255,255,0.05)">{{license.license_key}}</code></div></div><div class="flex items-center gap-2 flex-wrap"><a href="/dashboard/licenses/{{license.id}}/edit" class="px-4 py-2 border border-white/[0.08] text-gray-400 rounded-lg text-sm hover:bg-white/[0.04] transition-colors"><i class="ri-edit-line mr-1"></i> Editar</a>{{#if (eq license.license_type 'free')}}<form action="/dashboard/licenses/{{license.id}}/upgrade" method="POST" class="inline"><input type="hidden" name="plan_type" value="annual"><button class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-700 transition-colors"><i class="ri-vip-crown-line mr-1"></i> Upgrade PRO</button></form>{{/if}}<form action="/dashboard/licenses/{{license.id}}/renew" method="POST" class="inline"><button class="px-4 py-2 text-white rounded-lg text-sm font-semibold hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-refresh-line mr-1"></i> Renovar</button></form><form action="/dashboard/licenses/{{license.id}}/unlock" method="POST" class="inline"><button class="px-4 py-2 bg-amber-600 text-white rounded-lg text-sm font-semibold hover:bg-amber-700 transition-colors"><i class="ri-lock-unlock-line mr-1"></i> Unlock</button></form></div></div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="glass-card p-5"><p class="text-[10px] text-gray-500 uppercase tracking-wider mb-2">Estado</p>{{{statusBadge license.status}}} {{{typeBadge license.license_type}}}<p class="text-xs text-gray-500 mt-2">Plan: {{license.plan_type}}</p></div>
    <div class="glass-card p-5"><p class="text-[10px] text-gray-500 uppercase tracking-wider mb-2">Vigencia</p><p class="text-sm text-gray-300"><strong class="text-gray-400">Inicio:</strong> {{formatDate license.start_date}}</p><p class="text-sm text-gray-300"><strong class="text-gray-400">Fin:</strong> {{formatDate license.end_date}}</p><p class="text-sm mt-1 {{#if isExpired}}text-red-400 font-bold{{else}}text-emerald-400{{/if}}">{{#if isExpired}}Expirada{{else}}{{daysRemaining}} dias restantes{{/if}}</p></div>
    <div class="glass-card p-5"><p class="text-[10px] text-gray-500 uppercase tracking-wider mb-2">App</p><p class="text-sm text-gray-300"><strong class="text-gray-400">Version:</strong> {{license.app_version}}</p><p class="text-sm text-gray-300"><strong class="text-gray-400">Verificaciones:</strong> {{license.total_verifications}}</p></div>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="glass-card p-6"><h3 class="text-lg font-semibold text-white mb-4"><i class="ri-user-line mr-2" style="color:#2DD4A8"></i>Datos</h3><dl class="space-y-2 text-sm"><div class="flex justify-between"><dt class="text-gray-500">Email:</dt><dd class="font-medium text-gray-300">{{license.email}}</dd></div><div class="flex justify-between"><dt class="text-gray-500">Celular:</dt><dd class="text-gray-300">{{license.phone}}</dd></div><div class="flex justify-between"><dt class="text-gray-500">Pais:</dt><dd class="text-gray-300">{{license.country}}</dd></div><div class="flex justify-between"><dt class="text-gray-500">Rol:</dt><dd class="capitalize text-gray-300">{{license.user_role}}</dd></div><div class="flex justify-between"><dt class="text-gray-500">IP Registro:</dt><dd class="font-mono text-xs text-gray-400">{{license.registration_ip}}</dd></div></dl></div>
    <div class="glass-card p-6"><h3 class="text-lg font-semibold text-white mb-4"><i class="ri-shield-line mr-2 text-red-400"></i>Seguridad</h3><dl class="space-y-2 text-sm"><div><dt class="text-gray-500 mb-1">Enc. Key:</dt><dd class="font-mono text-xs p-2 rounded break-all text-gray-400" style="background:rgba(255,255,255,0.03)">{{truncate license.encryption_key 60}}</dd></div><div class="flex justify-between"><dt class="text-gray-500">Ultima verif. IP:</dt><dd class="font-mono text-xs text-gray-400">{{license.last_verification_ip}}</dd></div>{{#if license.unlock_code}}<div class="flex justify-between"><dt class="text-gray-500">Unlock activo:</dt><dd class="font-bold text-amber-400">{{license.unlock_code}}</dd></div>{{/if}}</dl></div>
  </div>
  <div class="glass-card p-6"><div class="flex items-center justify-between mb-4"><h3 class="text-lg font-semibold text-white"><i class="ri-computer-line mr-2" style="color:#3B82F6"></i>Dispositivos</h3><a href="/dashboard/devices/migrate/{{license.id}}" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-semibold hover:bg-blue-700 transition-colors"><i class="ri-swap-line mr-1"></i> Migrar</a></div>{{#if license.devices.length}}<table class="w-full text-sm"><thead><tr class="text-left text-[10px] text-gray-500 uppercase tracking-wider border-b border-white/[0.06]"><th class="pb-2 pr-4">ID</th><th class="pb-2 pr-4">Nombre</th><th class="pb-2 pr-4">SO</th><th class="pb-2 pr-4">Estado</th><th class="pb-2">Ultimo acceso</th></tr></thead><tbody>{{#each license.devices}}<tr class="border-b border-white/[0.04]"><td class="py-2 pr-4 font-mono text-xs text-gray-500">{{truncate this.device_id 20}}</td><td class="py-2 pr-4 text-gray-300">{{this.device_name}}</td><td class="py-2 pr-4 text-gray-400">{{this.device_os}}</td><td class="py-2 pr-4">{{#if this.is_active}}<span class="text-emerald-400 text-xs font-semibold">Activo</span>{{else}}<span class="text-gray-500 text-xs">Inactivo</span>{{/if}}</td><td class="py-2 text-xs text-gray-500">{{formatDateTime this.last_seen}}</td></tr>{{/each}}</tbody></table>{{else}}<p class="text-sm text-gray-500 text-center py-4">Sin dispositivos.</p>{{/if}}
    <div class="mt-4 pt-4 border-t border-white/[0.06]"><details><summary class="cursor-pointer text-sm font-medium text-gray-400 hover:text-gray-200 transition-colors"><i class="ri-add-circle-line mr-1"></i> Pago Manual</summary><form action="/dashboard/payments/manual" method="POST" class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3"><input type="hidden" name="license_id" value="{{license.id}}"><select name="plan_type" required class="px-4 py-2 rounded-lg text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="monthly">Mensual ($7)</option><option value="annual">Anual ($49)</option></select><input type="number" name="amount" step="0.01" placeholder="Monto" class="px-4 py-2 rounded-lg text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><button type="submit" class="px-4 py-2 text-white rounded-lg text-sm font-semibold hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)">Registrar</button></form></details></div>
  </div>
  <div class="glass-card p-6"><h3 class="text-lg font-semibold text-white mb-4"><i class="ri-file-list-3-line mr-2" style="color:#6366F1"></i>Ultimos Accesos</h3><table class="w-full text-sm"><thead><tr class="text-left text-[10px] text-gray-500 uppercase tracking-wider border-b border-white/[0.06]"><th class="pb-2 pr-4">Accion</th><th class="pb-2 pr-4">IP</th><th class="pb-2 pr-4">Pais</th><th class="pb-2 pr-4">Resultado</th><th class="pb-2">Fecha</th></tr></thead><tbody>{{#each license.access_nodes}}<tr class="border-b border-white/[0.04]"><td class="py-2 pr-4"><span class="px-2 py-0.5 text-[10px] rounded-full text-gray-400" style="background:rgba(255,255,255,0.05)">{{this.action}}</span></td><td class="py-2 pr-4 font-mono text-xs text-gray-500">{{this.ip_address}}</td><td class="py-2 pr-4 text-xs text-gray-400">{{this.country}}/{{this.city}}</td><td class="py-2 pr-4">{{#if this.response_status}}<span class="text-emerald-400 text-xs">&#10003;</span>{{else}}<span class="text-red-400 text-xs">&#10007;</span>{{/if}}</td><td class="py-2 text-xs text-gray-500">{{formatDateTime this.accessed_at}}</td></tr>{{/each}}</tbody></table></div>
</div>
