<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center gap-3"><a href="/dashboard/licenses/{{license.id}}" class="p-2 text-gray-500 hover:bg-white/[0.06] rounded-lg transition-colors"><i class="ri-arrow-left-line text-lg"></i></a><h1 class="text-2xl font-bold text-white">Editar Licencia</h1><code class="text-sm px-2 py-1 rounded font-mono ml-2 text-gray-400" style="background:rgba(255,255,255,0.05)">{{license.license_key}}</code></div>
  <form action="/dashboard/licenses/{{license.id}}?_method=PUT" method="POST" class="space-y-6">
    <div class="glass-card p-6"><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">Nombre</label><input type="text" name="name" value="{{license.name}}" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Email</label><input type="email" name="email" value="{{license.email}}" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Celular</label><input type="tel" name="phone" value="{{license.phone}}" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Pais</label><input type="text" name="country" value="{{license.country}}" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Rol</label><select name="user_role" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="estudiante" {{#if (eq license.user_role 'estudiante')}}selected{{/if}}>Estudiante</option><option value="docente" {{#if (eq license.user_role 'docente')}}selected{{/if}}>Docente</option><option value="programador" {{#if (eq license.user_role 'programador')}}selected{{/if}}>Programador</option><option value="emprendedor" {{#if (eq license.user_role 'emprendedor')}}selected{{/if}}>Emprendedor</option><option value="investigador" {{#if (eq license.user_role 'investigador')}}selected{{/if}}>Investigador</option></select></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Tipo</label><select name="license_type" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="free" {{#if (eq license.license_type 'free')}}selected{{/if}}>Free</option><option value="pro" {{#if (eq license.license_type 'pro')}}selected{{/if}}>Pro</option></select></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Plan</label><select name="plan_type" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="free" {{#if (eq license.plan_type 'free')}}selected{{/if}}>Gratuito</option><option value="monthly" {{#if (eq license.plan_type 'monthly')}}selected{{/if}}>Mensual</option><option value="annual" {{#if (eq license.plan_type 'annual')}}selected{{/if}}>Anual</option></select></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Estado</label><select name="status" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="active" {{#if (eq license.status 'active')}}selected{{/if}}>Activa</option><option value="expired" {{#if (eq license.status 'expired')}}selected{{/if}}>Expirada</option><option value="suspended" {{#if (eq license.status 'suspended')}}selected{{/if}}>Suspendida</option><option value="pending" {{#if (eq license.status 'pending')}}selected{{/if}}>Pendiente</option><option value="cancelled" {{#if (eq license.status 'cancelled')}}selected{{/if}}>Cancelada</option></select></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Version App</label><input type="text" name="app_version" value="{{license.app_version}}" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div class="flex items-center gap-3 mt-6"><input type="checkbox" name="auto_renew" id="ar" {{#if license.auto_renew}}checked{{/if}} class="w-4 h-4 accent-emerald-500"><label for="ar" class="text-sm text-gray-400">Auto-Renovar</label></div></div></div>
    <div class="glass-card p-6"><textarea name="notes" rows="3" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200 resize-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)" placeholder="Notas">{{license.notes}}</textarea></div>
    <div class="flex justify-end gap-3"><a href="/dashboard/licenses/{{license.id}}" class="px-6 py-2.5 border border-white/[0.08] text-gray-400 rounded-xl text-sm hover:bg-white/[0.04] transition-colors">Cancelar</a><button type="submit" class="px-6 py-2.5 text-white rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-save-line mr-1"></i> Guardar</button></div>
  </form>
</div>
