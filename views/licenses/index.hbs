<div class="space-y-6">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"><div><h1 class="text-2xl font-bold text-gray-900">Licencias</h1><p class="text-sm text-gray-500 mt-1">{{pagination.total}} registradas</p></div><a href="/dashboard/licenses/create" class="px-4 py-2.5 bg-primary-600 text-white rounded-xl text-sm font-semibold hover:bg-primary-700 flex items-center gap-2"><i class="ri-add-line"></i> Nueva</a></div>
  <div class="bg-white rounded-xl border border-gray-200 p-4"><form method="GET" action="/dashboard/licenses" class="flex flex-col sm:flex-row gap-3"><div class="flex-1"><input type="text" name="search" value="{{search}}" placeholder="Buscar..." class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none"></div><select name="type" class="px-4 py-2.5 border border-gray-300 rounded-xl text-sm"><option value="">Tipo</option><option value="free">Free</option><option value="pro">Pro</option></select><select name="status" class="px-4 py-2.5 border border-gray-300 rounded-xl text-sm"><option value="">Estado</option><option value="active">Activa</option><option value="expired">Expirada</option><option value="suspended">Suspendida</option><option value="pending">Pendiente</option></select><button type="submit" class="px-6 py-2.5 bg-gray-800 text-white rounded-xl text-sm"><i class="ri-search-line"></i> Filtrar</button></form></div>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">Titular</th><th class="px-4 py-3">Tipo</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Expira</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody class="divide-y divide-gray-100">{{#each licenses}}<tr class="hover:bg-gray-50"><td class="px-4 py-3"><code class="text-xs bg-gray-100 px-2 py-1 rounded font-mono">{{truncate this.license_key 20}}</code></td><td class="px-4 py-3"><p class="font-medium text-gray-900">{{this.name}}</p><p class="text-xs text-gray-500">{{#if (eq this.auth_provider 'google')}}<i class="ri-google-fill text-blue-600" title="Google"></i> {{/if}}{{this.email}}</p></td><td class="px-4 py-3">{{{typeBadge this.license_type}}}</td><td class="px-4 py-3">{{{statusBadge this.status}}}</td><td class="px-4 py-3 text-xs">{{formatDate this.end_date}}</td><td class="px-4 py-3"><div class="flex items-center gap-1"><a href="/dashboard/licenses/{{this.id}}" class="p-1.5 text-gray-500 hover:bg-blue-50 hover:text-blue-600 rounded-lg"><i class="ri-eye-line"></i></a><a href="/dashboard/licenses/{{this.id}}/edit" class="p-1.5 text-gray-500 hover:bg-amber-50 hover:text-amber-600 rounded-lg"><i class="ri-edit-line"></i></a><form action="/dashboard/licenses/{{this.id}}?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('¿Eliminar?')"><button class="p-1.5 text-gray-500 hover:bg-red-50 hover:text-red-600 rounded-lg"><i class="ri-delete-bin-line"></i></button></form></div></td></tr>{{/each}}</tbody></table></div>{{#if (gt pagination.totalPages 1)}}<div class="px-4 py-3 bg-gray-50 border-t flex justify-between"><span class="text-sm text-gray-500">Pág {{pagination.page}}/{{pagination.totalPages}}</span><div class="flex gap-1">{{#if pagination.hasPrev}}<a href="?page={{inc (inc pagination.page -2)}}&search={{search}}" class="px-3 py-1 text-sm border rounded-lg">Ant</a>{{/if}}{{#if pagination.hasNext}}<a href="?page={{inc pagination.page}}&search={{search}}" class="px-3 py-1 text-sm border rounded-lg">Sig</a>{{/if}}</div></div>{{/if}}</div>
</div>
