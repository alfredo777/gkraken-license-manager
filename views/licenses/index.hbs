<div class="space-y-6">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"><div><h1 class="text-2xl font-bold text-white">Licencias</h1><p class="text-sm text-gray-500 mt-1">{{pagination.total}} registradas</p></div><a href="/dashboard/licenses/create" class="px-4 py-2.5 text-white rounded-xl text-sm font-semibold flex items-center gap-2" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-add-line"></i> Nueva</a></div>
  <div class="glass-card p-4"><form method="GET" action="/dashboard/licenses" class="flex flex-col sm:flex-row gap-3"><div class="flex-1"><input type="text" name="search" value="{{search}}" placeholder="Buscar..." class="w-full px-4 py-2.5 rounded-xl text-sm outline-none text-gray-200 placeholder-gray-500" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)" focus:ring-2 focus:ring-emerald-500></div><select name="type" class="px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="">Tipo</option><option value="free">Free</option><option value="pro">Pro</option></select><select name="status" class="px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="">Estado</option><option value="active">Activa</option><option value="expired">Expirada</option><option value="suspended">Suspendida</option><option value="pending">Pendiente</option></select><button type="submit" class="px-6 py-2.5 text-white rounded-xl text-sm" style="background:rgba(255,255,255,0.08)"><i class="ri-search-line"></i> Filtrar</button></form></div>
  <div class="glass-card overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left text-[10px] text-gray-500 uppercase tracking-wider" style="background:rgba(255,255,255,0.02)"><th class="px-4 py-3">Licencia</th><th class="px-4 py-3">Titular</th><th class="px-4 py-3">Tipo</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Expira</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody class="divide-y divide-white/[0.04]">{{#each licenses}}<tr class="hover:bg-emerald-500/[0.03] transition-colors"><td class="px-4 py-3"><code class="text-xs px-2 py-1 rounded font-mono text-gray-400" style="background:rgba(255,255,255,0.05)">{{truncate this.license_key 20}}</code></td><td class="px-4 py-3"><p class="font-medium text-gray-200">{{this.name}}</p><p class="text-xs text-gray-500">{{this.email}}</p></td><td class="px-4 py-3">{{{typeBadge this.license_type}}}</td><td class="px-4 py-3">{{{statusBadge this.status}}}</td><td class="px-4 py-3 text-xs text-gray-400">{{formatDate this.end_date}}</td><td class="px-4 py-3"><div class="flex items-center gap-1"><a href="/dashboard/licenses/{{this.id}}" class="p-1.5 text-gray-500 hover:text-blue-400 hover:bg-blue-500/10 rounded-lg transition-colors"><i class="ri-eye-line"></i></a><a href="/dashboard/licenses/{{this.id}}/edit" class="p-1.5 text-gray-500 hover:text-amber-400 hover:bg-amber-500/10 rounded-lg transition-colors"><i class="ri-edit-line"></i></a><form action="/dashboard/licenses/{{this.id}}?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Eliminar?')"><button class="p-1.5 text-gray-500 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors"><i class="ri-delete-bin-line"></i></button></form></div></td></tr>{{/each}}</tbody></table></div>{{#if (gt pagination.totalPages 1)}}<div class="px-4 py-3 border-t border-white/[0.04] flex justify-between" style="background:rgba(255,255,255,0.02)"><span class="text-sm text-gray-500">Pag {{pagination.page}}/{{pagination.totalPages}}</span><div class="flex gap-1">{{#if pagination.hasPrev}}<a href="?page={{inc (inc pagination.page -2)}}&search={{search}}" class="px-3 py-1 text-sm border border-white/[0.08] rounded-lg text-gray-400 hover:bg-white/[0.04]">Ant</a>{{/if}}{{#if pagination.hasNext}}<a href="?page={{inc pagination.page}}&search={{search}}" class="px-3 py-1 text-sm border border-white/[0.08] rounded-lg text-gray-400 hover:bg-white/[0.04]">Sig</a>{{/if}}</div></div>{{/if}}</div>
</div>
