<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center gap-3"><a href="/dashboard/licenses" class="p-2 text-gray-500 hover:bg-gray-100 rounded-lg"><i class="ri-arrow-left-line text-lg"></i></a><h1 class="text-2xl font-bold text-gray-900">Nueva Licencia</h1></div>
  <form action="/dashboard/licenses" method="POST" class="space-y-6">
    <div class="bg-white rounded-xl border p-6"><h2 class="text-lg font-semibold mb-4"><i class="ri-user-line mr-2 text-primary-600"></i>Información Personal</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label><input type="text" name="name" required class="w-full px-4 py-2.5 border rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Email *</label><input type="email" name="email" required class="w-full px-4 py-2.5 border rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Celular</label><input type="tel" name="phone" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">País</label><input type="text" name="country" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Rol</label><select name="user_role" class="w-full px-4 py-2.5 border rounded-xl text-sm"><option value="estudiante">Estudiante</option><option value="docente">Docente</option><option value="programador" selected>Programador</option><option value="emprendedor">Emprendedor</option><option value="investigador">Investigador</option><option value="empresa">Empresa</option><option value="otro">Otro</option></select></div></div></div>
    <div class="bg-white rounded-xl border p-6"><h2 class="text-lg font-semibold mb-4"><i class="ri-key-2-line mr-2 text-accent-600"></i>Licencia</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-700 mb-1">Tipo *</label><select name="license_type" class="w-full px-4 py-2.5 border rounded-xl text-sm"><option value="free">Free</option><option value="pro">Pro</option></select></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Plan</label><select name="plan_type" class="w-full px-4 py-2.5 border rounded-xl text-sm"><option value="free">Gratuito</option><option value="monthly">Mensual ($7)</option><option value="annual">Anual ($49)</option></select></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Dispositivos permitidos</label><input type="number" name="max_devices" min="1" max="50" value="1" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div></div></div>
    <div class="bg-white rounded-xl border p-6"><h2 class="text-lg font-semibold mb-4"><i class="ri-computer-line mr-2 text-green-600"></i>Dispositivo (opcional)</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-700 mb-1">ID Dispositivo</label><input type="text" name="device_id" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label><input type="text" name="device_name" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">SO</label><input type="text" name="device_os" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">CPU</label><input type="text" name="device_cpu" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">RAM</label><input type="text" name="device_ram" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div></div></div>
    <div class="bg-white rounded-xl border p-6"><label class="block text-sm font-medium text-gray-700 mb-1">Notas</label><textarea name="notes" rows="3" class="w-full px-4 py-2.5 border rounded-xl text-sm resize-none"></textarea></div>
    <div class="flex justify-end gap-3"><a href="/dashboard/licenses" class="px-6 py-2.5 border text-gray-700 rounded-xl text-sm">Cancelar</a><button type="submit" class="px-6 py-2.5 bg-primary-600 text-white rounded-xl text-sm font-semibold hover:bg-primary-700"><i class="ri-check-line mr-1"></i> Crear</button></div>
  </form>
</div>
