<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center gap-3"><a href="/dashboard/licenses" class="p-2 text-gray-500 hover:bg-white/[0.06] rounded-lg transition-colors"><i class="ri-arrow-left-line text-lg"></i></a><h1 class="text-2xl font-bold text-white">Nueva Licencia</h1></div>
  <form action="/dashboard/licenses" method="POST" class="space-y-6">
    <div class="glass-card p-6"><h2 class="text-lg font-semibold text-white mb-4"><i class="ri-user-line mr-2" style="color:#2DD4A8"></i>Informacion Personal</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">Nombre *</label><input type="text" name="name" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200 outline-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Email *</label><input type="email" name="email" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200 outline-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Celular</label><input type="tel" name="phone" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Pais</label><input type="text" name="country" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Rol</label><select name="user_role" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="estudiante">Estudiante</option><option value="docente">Docente</option><option value="programador" selected>Programador</option><option value="emprendedor">Emprendedor</option><option value="investigador">Investigador</option></select></div></div></div>
    <div class="glass-card p-6"><h2 class="text-lg font-semibold text-white mb-4"><i class="ri-key-2-line mr-2" style="color:#6366F1"></i>Licencia</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">Tipo *</label><select name="license_type" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="free">Free</option><option value="pro">Pro</option></select></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Plan</label><select name="plan_type" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="free">Gratuito</option><option value="monthly">Mensual ($7)</option><option value="annual">Anual ($49)</option></select></div></div></div>
    <div class="glass-card p-6"><h2 class="text-lg font-semibold text-white mb-4"><i class="ri-computer-line mr-2" style="color:#F97316"></i>Dispositivo (opcional)</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">ID Dispositivo</label><input type="text" name="device_id" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Nombre</label><input type="text" name="device_name" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">SO</label><input type="text" name="device_os" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">CPU</label><input type="text" name="device_cpu" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">RAM</label><input type="text" name="device_ram" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div></div></div>
    <div class="glass-card p-6"><label class="block text-sm font-medium text-gray-400 mb-1">Notas</label><textarea name="notes" rows="3" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200 resize-none" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></textarea></div>
    <div class="flex justify-end gap-3"><a href="/dashboard/licenses" class="px-6 py-2.5 border border-white/[0.08] text-gray-400 rounded-xl text-sm hover:bg-white/[0.04] transition-colors">Cancelar</a><button type="submit" class="px-6 py-2.5 text-white rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-check-line mr-1"></i> Crear</button></div>
  </form>
</div>
