<div class="min-h-screen flex items-center justify-center p-4" style="background:linear-gradient(135deg,#0a0a0f 0%,#0f1520 50%,#0a0a0f 100%)">
  <div class="w-full max-w-md"><div class="rounded-2xl shadow-2xl p-8" style="background:rgba(255,255,255,0.03);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.06)">
    <div class="text-center mb-8"><div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-shield-keyhole-fill text-white text-3xl"></i></div><h1 class="text-2xl font-bold text-white">{{appName}}</h1><p class="text-gray-500 text-sm mt-1">Panel de Administracion</p></div>
    <form action="/admin/login" method="POST" class="space-y-4">
      <div><label class="block text-sm font-medium text-gray-400 mb-1">Usuario</label><div class="relative"><i class="ri-user-line absolute left-3 top-1/2 -translate-y-1/2 text-gray-600"></i><input type="text" name="username" required class="w-full pl-10 pr-4 py-2.5 rounded-xl outline-none text-gray-200 placeholder-gray-600" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)" placeholder="admin"></div></div>
      <div><label class="block text-sm font-medium text-gray-400 mb-1">Contrasena</label><div class="relative"><i class="ri-lock-line absolute left-3 top-1/2 -translate-y-1/2 text-gray-600"></i><input type="password" name="password" required class="w-full pl-10 pr-4 py-2.5 rounded-xl outline-none text-gray-200 placeholder-gray-600" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)" placeholder="********"></div></div>
      <div><label class="block text-sm font-medium text-gray-400 mb-1">Codigo de Acceso</label><div class="relative"><i class="ri-key-line absolute left-3 top-1/2 -translate-y-1/2 text-gray-600"></i><input type="text" name="access_code" class="w-full pl-10 pr-4 py-2.5 rounded-xl outline-none text-gray-200 placeholder-gray-600" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)" placeholder="Opcional"></div></div>
      <button type="submit" class="w-full py-3 text-white rounded-xl font-semibold shadow-lg hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-login-box-line mr-2"></i> Iniciar Sesion</button>
    </form>
    <div class="mt-6 border-t border-white/[0.06] pt-6"><button onclick="document.getElementById('activationForm').classList.toggle('hidden')" class="text-sm font-medium hover:opacity-80 transition-opacity" style="color:#2DD4A8"><i class="ri-mail-check-line mr-1"></i> Activar cuenta</button>
      <form action="/admin/activate" method="POST" class="hidden mt-4 space-y-3" id="activationForm"><input type="email" name="email" required placeholder="Email" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200 placeholder-gray-600" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><input type="text" name="activation_code" required placeholder="Codigo (6 digitos)" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200 placeholder-gray-600" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><button type="submit" class="w-full py-2.5 text-white rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)">Activar</button></form>
    </div>
    <div class="mt-4 text-center"><a href="/" class="text-sm text-gray-500 hover:text-gray-300 transition-colors"><i class="ri-arrow-left-line mr-1"></i> Volver al inicio</a></div>
  </div></div>
</div>
