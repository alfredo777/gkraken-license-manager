<div class="max-w-2xl mx-auto space-y-6"><h1 class="text-2xl font-bold text-white">Mi Perfil</h1><form action="/admin/profile" method="POST" class="space-y-6"><div class="glass-card p-6"><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">Usuario</label><input type="text" value="{{adminData.username}}" disabled class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-400" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Email</label><input type="email" name="email" value="{{adminData.email}}" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Celular</label><input type="tel" name="phone" value="{{adminData.phone}}" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Codigo Acceso</label><input type="text" name="access_code" value="{{adminData.access_code}}" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div></div></div><div class="glass-card p-6"><h2 class="text-lg font-semibold text-white mb-4">Cambiar Contrasena</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">Actual</label><input type="password" name="current_password" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Nueva</label><input type="password" name="new_password" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div></div></div><button type="submit" class="w-full py-3 text-white rounded-xl font-semibold hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-save-line mr-2"></i> Guardar</button></form></div>
