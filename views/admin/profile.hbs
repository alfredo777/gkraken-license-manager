<div class="max-w-2xl mx-auto space-y-6"><h1 class="text-2xl font-bold text-gray-900">Mi Perfil</h1><form action="/admin/profile" method="POST" class="space-y-6"><div class="bg-white rounded-xl border p-6"><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium mb-1">Usuario</label><input type="text" value="{{adminData.username}}" disabled class="w-full px-4 py-2.5 bg-gray-100 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Email</label><input type="email" name="email" value="{{adminData.email}}" required class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Celular</label><input type="tel" name="phone" value="{{adminData.phone}}" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Código Acceso</label><input type="text" name="access_code" value="{{adminData.access_code}}" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div></div></div><div class="bg-white rounded-xl border p-6"><h2 class="text-lg font-semibold mb-4">Cambiar Contraseña</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium mb-1">Actual</label><input type="password" name="current_password" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Nueva</label><input type="password" name="new_password" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div></div></div><button type="submit" class="w-full py-3 bg-primary-600 text-white rounded-xl font-semibold hover:bg-primary-700"><i class="ri-save-line mr-2"></i> Guardar</button></form></div>
