<div class="space-y-6"><h1 class="text-2xl font-bold text-gray-900">Configuración</h1>
  <div class="bg-white rounded-xl border p-6"><h2 class="text-lg font-semibold mb-4"><i class="ri-user-add-line mr-2 text-primary-600"></i>Nuevo Admin</h2><form action="/admin/register" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium mb-1">Usuario *</label><input type="text" name="username" required class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Email *</label><input type="email" name="email" required class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Celular *</label><input type="tel" name="phone" required class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Rol</label><select name="role" class="w-full px-4 py-2.5 border rounded-xl text-sm"><option value="admin">Admin</option><option value="support">Soporte</option><option value="superadmin">Super Admin</option></select></div><div><label class="block text-sm font-medium mb-1">Contraseña *</label><input type="password" name="password" required minlength="8" class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div><label class="block text-sm font-medium mb-1">Confirmar *</label><input type="password" name="password_confirm" required class="w-full px-4 py-2.5 border rounded-xl text-sm"></div><div class="md:col-span-2"><button type="submit" class="px-6 py-2.5 bg-primary-600 text-white rounded-xl text-sm font-semibold hover:bg-primary-700"><i class="ri-add-line mr-1"></i> Crear</button></div></form></div>
  <div class="bg-white rounded-xl border overflow-hidden"><div class="p-6 border-b"><h2 class="text-lg font-semibold">Administradores</h2></div><table class="w-full text-sm"><thead class="bg-gray-50"><tr class="text-left text-xs text-gray-500 uppercase"><th class="px-4 py-3">Usuario</th><th class="px-4 py-3">Email</th><th class="px-4 py-3">Rol</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Último Login</th></tr></thead><tbody class="divide-y">{{#each admins}}<tr class="hover:bg-gray-50"><td class="px-4 py-3 font-medium">{{this.username}}</td><td class="px-4 py-3">{{this.email}}</td><td class="px-4 py-3"><span class="px-2 py-1 text-xs rounded-full bg-indigo-100 text-indigo-800">{{this.role}}</span></td><td class="px-4 py-3">{{#if this.is_active}}<span class="text-green-600 text-xs font-semibold">Activo</span>{{else}}<span class="text-gray-400 text-xs">Inactivo</span>{{/if}}</td><td class="px-4 py-3 text-xs text-gray-500">{{formatDateTime this.last_login}}</td></tr>{{/each}}</tbody></table></div>
</div>
