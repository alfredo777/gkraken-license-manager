<div class="space-y-6"><h1 class="text-2xl font-bold text-white">Configuracion</h1>
  <div class="glass-card p-6"><h2 class="text-lg font-semibold text-white mb-4"><i class="ri-user-add-line mr-2" style="color:#2DD4A8"></i>Nuevo Admin</h2><form action="/admin/register" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4"><div><label class="block text-sm font-medium text-gray-400 mb-1">Usuario *</label><input type="text" name="username" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Email *</label><input type="email" name="email" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Celular *</label><input type="tel" name="phone" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Rol</label><select name="role" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-300" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"><option value="admin">Admin</option><option value="support">Soporte</option><option value="superadmin">Super Admin</option></select></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Contrasena *</label><input type="password" name="password" required minlength="8" class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div><label class="block text-sm font-medium text-gray-400 mb-1">Confirmar *</label><input type="password" name="password_confirm" required class="w-full px-4 py-2.5 rounded-xl text-sm text-gray-200" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)"></div><div class="md:col-span-2"><button type="submit" class="px-6 py-2.5 text-white rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity" style="background:linear-gradient(135deg,#2DD4A8,#059669)"><i class="ri-add-line mr-1"></i> Crear</button></div></form></div>
  <div class="glass-card overflow-hidden"><div class="p-6 border-b border-white/[0.06]"><h2 class="text-lg font-semibold text-white">Administradores</h2></div><table class="w-full text-sm"><thead><tr class="text-left text-[10px] text-gray-500 uppercase tracking-wider" style="background:rgba(255,255,255,0.02)"><th class="px-4 py-3">Usuario</th><th class="px-4 py-3">Email</th><th class="px-4 py-3">Rol</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Ultimo Login</th></tr></thead><tbody class="divide-y divide-white/[0.04]">{{#each admins}}<tr class="hover:bg-emerald-500/[0.03] transition-colors"><td class="px-4 py-3 font-medium text-gray-200">{{this.username}}</td><td class="px-4 py-3 text-gray-400">{{this.email}}</td><td class="px-4 py-3"><span class="px-2 py-1 text-xs rounded-full text-indigo-400" style="background:rgba(99,102,241,0.1)">{{this.role}}</span></td><td class="px-4 py-3">{{#if this.is_active}}<span class="text-emerald-400 text-xs font-semibold">Activo</span>{{else}}<span class="text-gray-500 text-xs">Inactivo</span>{{/if}}</td><td class="px-4 py-3 text-xs text-gray-500">{{formatDateTime this.last_login}}</td></tr>{{/each}}</tbody></table></div>
</div>
