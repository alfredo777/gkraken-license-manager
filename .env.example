# Server
PORT=3000
NODE_ENV=development
# Genera cada secreto con: openssl rand -hex 32  (en producción son obligatorios)
SESSION_SECRET=change_this_super_secret_session_key_now_12345
JWT_SECRET=change_this_jwt_secret_key_now_67890

# Database
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-domain.mailgun.org
MAILGUN_FROM=noreply@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Coinbase Commerce (Bitcoin)
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_coinbase_webhook_secret

# App
APP_URL=http://localhost:3000
APP_NAME=LicenseManager
SUPPORT_EMAIL=soporte@yourdomain.com
# Clave que la app Green Kraken manda en X-API-Key (LICENSE_API_KEY al compilar).
# Obligatoria en producción, mínimo 32 caracteres.
API_KEY=

# Primer superadmin (se crea al arrancar si no hay admins; luego puedes borrarlo)
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_ACCESS_CODE=

# Login con Google (cliente OAuth tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Por defecto ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# Registro por formulario desde la app (por defecto solo Google)
ALLOW_FORM_REGISTRATION=false

# Pricing
PRICE_ANNUAL=49
PRICE_MONTHLY=7
CURRENCY=USD
