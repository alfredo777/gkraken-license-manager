# Server
PORT=3000
NODE_ENV=development
# Genera cada secreto con: openssl rand -hex 32  (en producción son obligatorios)
SESSION_SECRET=change_this_super_secret_session_key_now_12345
JWT_SECRET=change_this_jwt_secret_key_now_67890

# Database
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-domain.mailgun.org
MAILGUN_FROM=noreply@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Coinbase Commerce (Bitcoin)
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_coinbase_webhook_secret

# App
APP_URL=http://localhost:3000
APP_NAME=LicenseManager
SUPPORT_EMAIL=soporte@yourdomain.com
# Clave que la app Green Kraken manda en X-API-Key (LICENSE_API_KEY al compilar).
# Obligatoria en producción, mínimo 32 caracteres.
API_KEY=

# Primer superadmin (se crea al arrancar si no hay admins; luego puedes borrarlo)
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_ACCESS_CODE=

# Login con Google (cliente OAuth tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Por defecto ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# Descargas de la app en la landing (vacío = "Próximamente")
DOWNLOAD_URL_WINDOWS=
DOWNLOAD_URL_MACOS=
DOWNLOAD_URL_LINUX=

# Detrás de un proxy (nginx, Caddy…): 1. Necesario para la cookie segura del login web.
TRUST_PROXY=

# Registro por formulario desde la app (por defecto solo Google)
ALLOW_FORM_REGISTRATION=false

# Pricing
PRICE_ANNUAL=49
PRICE_MONTHLY=7
CURRENCY=USD

# ---- Gateway de IA (npm run gateway) ----
# Clave maestra para cifrar las claves de los proveedores: openssl rand -base64 32
# Debe ser la misma en el gestor (panel) y en el gateway. Si se pierde, hay que volver a cargar las claves.
AI_KEYS_MASTER_KEY=
GATEWAY_PORT=3100
GATEWAY_WORKERS=1
# URL pública del gateway (la app se compila con --dart-define=AI_GATEWAY_URL=...)
AI_GATEWAY_URL=
# Caché de token/plan y del catálogo de modelos (ms). Una revocación tarda como máximo esto.
AI_GATEWAY_CACHE_MS=30000
# Préstamo de tokens por copia del gateway y tiempo sin uso para devolverlo.
AI_QUOTA_LEASE_TOKENS=20000
AI_QUOTA_LEASE_IDLE_MS=15000
AI_USAGE_FLUSH_MS=2000
